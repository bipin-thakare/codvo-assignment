{
 "title": "Online Boutique: perf & chaos",
 "uid": "boutique-main",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "k6: checkout p95 (ms) [NEEDED: SLI]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "k6_http_req_duration_p95{step=\"place_order\"}",
     "legendFormat": "{{testid}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "k6: request rate [NEEDED: load shape]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(k6_http_reqs_total[30s]))",
     "legendFormat": "req/s",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU usage by pod (cores) [NEEDED: saturation]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"boutique\",container!=\"\"}[1m]))",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "CPU throttling ratio by pod [NEEDED: localized the bottleneck]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"boutique\"}[1m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"boutique\"}[1m]))",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Memory working set by pod",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"boutique\",container!=\"\"})",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Restarts (5m) [chaos]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"boutique\"}[5m]))",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Unavailable replicas [chaos]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kube_deployment_status_replicas_unavailable{namespace=\"boutique\"}",
     "legendFormat": "{{deployment}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Network receive by pod [DID NOT HELP: flat; payloads are small]",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"boutique\"}[1m]))",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "boutique"
 ]
}